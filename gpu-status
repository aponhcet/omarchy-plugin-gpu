    GPU_STATUS_INTEL_PRESENT=1 \
    GPU_STATUS_AMD_PRESENT=1 \
    GPU_STATUS_OUTPUTS='[]' \
    bash "$script" set amd >/dev/null
  [[ $(cat "$tmp/config/uwsm/gpu-mode") == amd ]] || fail "set amd did not stick"
  printf '%s\n' "$mode_before" >"$tmp/config/uwsm/gpu-mode"

  mkdir -p "$tmp/bins" "$tmp/desktops" "$tmp/pci/0000:00:02.0" "$tmp/pci/0000:01:00.0" \
    "$tmp/sys/renderD128" "$tmp/sys/renderD129" "$tmp/data/applications"
  printf '0x8086\n' >"$tmp/pci/0000:00:02.0/vendor"
  printf '0x10de\n' >"$tmp/pci/0000:01:00.0/vendor"
  ln -s "$tmp/pci/0000:00:02.0" "$tmp/sys/renderD129/device"
  ln -s "$tmp/pci/0000:01:00.0" "$tmp/sys/renderD128/device"
  cat >"$tmp/bins/chromium" <<EOF
#!/bin/bash
touch "$tmp/executed"
EOF
  cat >"$tmp/bins/voxtype" <<'EOF'
#!/bin/bash
exit 0
EOF
  chmod 755 "$tmp/bins/chromium" "$tmp/bins/voxtype"
  cat >"$tmp/desktops/chromium.desktop" <<'EOF'
[Desktop Entry]
Name=Chromium
Exec=chromium %U
Exec=/usr/bin/chromium --temp-profile
TryExec=chromium
Exec=other-helper
Exec=chromium --incognito
EOF
  cat >"$tmp/desktops/voxtype.desktop" <<'EOF'
[Desktop Entry]
Exec=voxtype
EOF
  launch=$(dirname "$script")/gpu-launch
  chmod 755 "$launch"

  set +e
  XDG_CONFIG_HOME="$tmp/config" XDG_DATA_HOME="$tmp/data" \
    GPU_STATUS_BIN_DIR="$tmp/bins" GPU_STATUS_DESKTOP_DIR="$tmp/desktops" \
    bash "$script" set-app 'chromium;touch /tmp/gpu-widget-pwned' intel >/dev/null 2>&1
  code=$?
  set -e
  [[ $code -ne 0 ]] || fail "poison app id was accepted"
  [[ ! -e /tmp/gpu-widget-pwned ]] || fail "app id was executed"
  [[ ! -e $tmp/config/uwsm/gpu-apps ]] || fail "poison id wrote a preference"
  [[ $(cat "$tmp/config/uwsm/gpu-mode") == "$mode_before" ]] || fail "set-app changed the login GPU"

  XDG_CONFIG_HOME="$tmp/config" XDG_DATA_HOME="$tmp/data" \
    GPU_STATUS_BIN_DIR="$tmp/bins" GPU_STATUS_DESKTOP_DIR="$tmp/desktops" \
    GPU_STATUS_ACTIVE=nvidia GPU_STATUS_NV_CONNECTED=1 \
    GPU_STATUS_NVIDIA_PRESENT=1 GPU_STATUS_INTEL_PRESENT=1 \
    GPU_STATUS_OUTPUTS='[]' \
    bash "$script" set-app chromium intel >/dev/null
  wrapper=$tmp/data/aponhcet.gpu/bin/chromium
  desk=$tmp/data/applications/chromium.desktop
  [[ -x $wrapper ]] || fail "app wrapper is not executable"
  grep -q -F "# aponhcet.gpu wrapper chromium" "$wrapper" || fail "wrapper is not marked"
  [[ -f $desk ]] || fail "desktop override was not written"
  grep -q '^X-AponhcetGpu=1$' "$desk" || fail "desktop override is not marked"
  grep -q -F "Exec=$wrapper %U" "$desk" || fail "Exec %U was not rewritten"
  grep -q -F "Exec=$wrapper --temp-profile" "$desk" || fail "absolute Exec was not rewritten"
  grep -q -F "Exec=$wrapper --incognito" "$desk" || fail "incognito Exec was not rewritten"
  grep -q -F "TryExec=$wrapper" "$desk" || fail "TryExec was not rewritten"
  grep -q -F "Exec=other-helper" "$desk" || fail "unrelated Exec was rewritten"
  grep -q "^chromium intel $tmp/bins/chromium chromium.desktop$" "$tmp/config/uwsm/gpu-apps" || fail "app preference was not saved"
  [[ $(cat "$tmp/config/uwsm/gpu-mode") == "$mode_before" ]] || fail "app pin changed the login GPU"
  [[ ! -e $tmp/executed ]] || fail "set-app started the program"

  app_json=$(
    XDG_CONFIG_HOME="$tmp/config" XDG_DATA_HOME="$tmp/data" \
      GPU_STATUS_BIN_DIR="$tmp/bins" GPU_STATUS_DESKTOP_DIR="$tmp/desktops" \
      GPU_STATUS_SYS_DRM="$tmp/sys" GPU_STATUS_DRI_ROOT="$tmp/missing-dri" \
      bash "$launch" --print chromium
  )
  [[ $app_json == *"mode=intel"* ]] || fail "launch print lost the intel mode"
  [[ $app_json == *"binary=$tmp/bins/chromium"* ]] || fail "launch print used the wrong program"
  [[ $app_json == *"gl=mesa"* ]] || fail "launch print lost the mesa driver"
  [[ $app_json == *"flag=--render-node-override=$tmp/missing-dri/by-path/pci-0000:00:02.0-render"* ]] || fail "launch print lost the render node"
  [[ $app_json == *"prime=-"* ]] || fail "intel launch printed a DRI prime id"
  [[ ! -e $tmp/executed ]] || fail "--print started the program"
  set +e
  XDG_CONFIG_HOME="$tmp/config" XDG_DATA_HOME="$tmp/data" \
    GPU_STATUS_BIN_DIR="$tmp/bins" GPU_STATUS_SYS_DRM="$tmp/sys" \
    GPU_STATUS_DRI_ROOT="$tmp/missing-dri" \
    bash "$launch" chromium >/dev/null 2>&1
  code=$?
  set -e
  [[ $code -ne 0 ]] || fail "missing render node still launched chromium"
  [[ ! -e $tmp/executed ]] || fail "missing render node started chromium"

  mkdir -p "$tmp/pci/0000:03:00.0" "$tmp/sys/renderD130"
  printf '0x1002\n' >"$tmp/pci/0000:03:00.0/vendor"
  ln -s "$tmp/pci/0000:03:00.0" "$tmp/sys/renderD130/device"
  XDG_CONFIG_HOME="$tmp/config" XDG_DATA_HOME="$tmp/data" \
    GPU_STATUS_BIN_DIR="$tmp/bins" GPU_STATUS_DESKTOP_DIR="$tmp/desktops" \
    GPU_STATUS_ACTIVE=nvidia GPU_STATUS_NV_CONNECTED=1 \
    GPU_STATUS_NVIDIA_PRESENT=1 GPU_STATUS_INTEL_PRESENT=1 GPU_STATUS_AMD_PRESENT=1 \
    GPU_STATUS_OUTPUTS='[]' \
    bash "$script" set-app chromium amd >/dev/null
  app_json=$(
    XDG_CONFIG_HOME="$tmp/config" XDG_DATA_HOME="$tmp/data" \
      GPU_STATUS_BIN_DIR="$tmp/bins" GPU_STATUS_DESKTOP_DIR="$tmp/desktops" \
      GPU_STATUS_SYS_DRM="$tmp/sys" GPU_STATUS_DRI_ROOT="$tmp/missing-dri" \
      bash "$launch" --print chromium
  )
  [[ $app_json == *"mode=amd"* ]] || fail "launch print lost the amd mode"
  [[ $app_json == *"gl=mesa"* ]] || fail "amd launch left the mesa driver"
  [[ $app_json == *"flag=--render-node-override=$tmp/missing-dri/by-path/pci-0000:03:00.0-render"* ]] || fail "amd launch lost the render node"
  [[ $app_json == *"prime=pci-0000_03_00_0"* ]] || fail "amd launch lost the DRI prime id"
  [[ ! -e $tmp/executed ]] || fail "amd --print started the program"
  XDG_CONFIG_HOME="$tmp/config" XDG_DATA_HOME="$tmp/data" \
    GPU_STATUS_BIN_DIR="$tmp/bins" GPU_STATUS_DESKTOP_DIR="$tmp/desktops" \
    GPU_STATUS_ACTIVE=nvidia GPU_STATUS_NV_CONNECTED=1 \
    GPU_STATUS_NVIDIA_PRESENT=1 GPU_STATUS_INTEL_PRESENT=1 \
    GPU_STATUS_OUTPUTS='[]' \
    bash "$script" set-app chromium intel >/dev/null

  json=$(
    XDG_CONFIG_HOME="$tmp/config" XDG_DATA_HOME="$tmp/data" \
      GPU_STATUS_BIN_DIR="$tmp/bins" \
      GPU_STATUS_ACTIVE=nvidia GPU_STATUS_NV_CONNECTED=1 \
      GPU_STATUS_NVIDIA_PRESENT=1 GPU_STATUS_INTEL_PRESENT=1 \
      GPU_STATUS_INTEL_NAME=UHD GPU_STATUS_NVIDIA_CSV= \
      GPU_STATUS_OUTPUTS='[]' \
      bash "$script" status
  )
  assert_jq "$json" '.apps | length == 1 and .[0].id == "chromium" and .[0].gpu == "none" and .[0].preference == "intel" and .[0].launchable == true and .[0].attached == true'
  json=$(
    XDG_CONFIG_HOME="$tmp/config" XDG_DATA_HOME="$tmp/data" \
      GPU_STATUS_BIN_DIR="$tmp/bins" \
      GPU_STATUS_ACTIVE=nvidia GPU_STATUS_NV_CONNECTED=1 \
      GPU_STATUS_NVIDIA_PRESENT=1 GPU_STATUS_INTEL_PRESENT=1 \
      GPU_STATUS_OUTPUTS='[]' \
      bash "$script" brief
  )
  assert_jq "$json" '.apps == []'

  XDG_CONFIG_HOME="$tmp/config" XDG_DATA_HOME="$tmp/data" \
    GPU_STATUS_BIN_DIR="$tmp/bins" GPU_STATUS_DESKTOP_DIR="$tmp/desktops" \
    GPU_STATUS_ACTIVE=nvidia GPU_STATUS_NV_CONNECTED=1 \
    GPU_STATUS_NVIDIA_PRESENT=1 GPU_STATUS_INTEL_PRESENT=1 \
    GPU_STATUS_OUTPUTS='[]' \
    bash "$script" set-app voxtype nvidia >/dev/null
  app_json=$(
    XDG_CONFIG_HOME="$tmp/config" XDG_DATA_HOME="$tmp/data" \
      GPU_STATUS_BIN_DIR="$tmp/bins" GPU_STATUS_SYS_DRM="$tmp/sys" \
      bash "$launch" --print voxtype
  )
  [[ $app_json == *"mode=nvidia"* && $app_json == *"gl=nvidia"* && $app_json == *"flag=-"* && $app_json == *"prime=-"* ]] || fail "non-browser pin passed a render node"
  XDG_CONFIG_HOME="$tmp/config" XDG_DATA_HOME="$tmp/data" \
    GPU_STATUS_BIN_DIR="$tmp/bins" GPU_STATUS_DESKTOP_DIR="$tmp/desktops" \
    GPU_STATUS_ACTIVE=nvidia GPU_STATUS_NV_CONNECTED=1 \
    GPU_STATUS_NVIDIA_PRESENT=1 GPU_STATUS_INTEL_PRESENT=1 GPU_STATUS_AMD_PRESENT=1 \
    GPU_STATUS_OUTPUTS='[]' \
    bash "$script" set-app voxtype amd >/dev/null
  app_json=$(
    XDG_CONFIG_HOME="$tmp/config" XDG_DATA_HOME="$tmp/data" \
      GPU_STATUS_BIN_DIR="$tmp/bins" GPU_STATUS_SYS_DRM="$tmp/sys" \
      GPU_STATUS_DRI_ROOT="$tmp/missing-dri" \
      bash "$launch" --print voxtype
  )
  [[ $app_json == *"mode=amd"* && $app_json == *"gl=mesa"* && $app_json == *"flag=-"* && $app_json == *"prime=pci-0000_03_00_0"* ]] || fail "non-browser amd pin lost DRI_PRIME"
  XDG_CONFIG_HOME="$tmp/config" XDG_DATA_HOME="$tmp/data" \
    GPU_STATUS_BIN_DIR="$tmp/bins" GPU_STATUS_DESKTOP_DIR="$tmp/desktops" \
    GPU_STATUS_ACTIVE=nvidia GPU_STATUS_NV_CONNECTED=1 \
    GPU_STATUS_NVIDIA_PRESENT=1 GPU_STATUS_INTEL_PRESENT=1 \
    GPU_STATUS_OUTPUTS='[]' \
    bash "$script" set-app voxtype nvidia >/dev/null

  printf '%s\n' 'Exec=chromium %U' 'Name=Mine' >"$tmp/data/applications/chromium.desktop"
  XDG_CONFIG_HOME="$tmp/config" XDG_DATA_HOME="$tmp/data" \
    GPU_STATUS_BIN_DIR="$tmp/bins" GPU_STATUS_DESKTOP_DIR="$tmp/desktops" \
    GPU_STATUS_ACTIVE=nvidia GPU_STATUS_NV_CONNECTED=1 \
    GPU_STATUS_NVIDIA_PRESENT=1 GPU_STATUS_INTEL_PRESENT=1 \
    GPU_STATUS_OUTPUTS='[]' \
    bash "$script" set-app chromium nvidia >/dev/null
  [[ $(cat "$tmp/data/applications/chromium.desktop") == $'Exec=chromium %U\nName=Mine' ]] || fail "foreign desktop file was overwritten"
  grep -q '^chromium nvidia ' "$tmp/config/uwsm/gpu-apps" || fail "preference was not saved beside a foreign desktop"
  json=$(
    XDG_CONFIG_HOME="$tmp/config" XDG_DATA_HOME="$tmp/data" \
      GPU_STATUS_BIN_DIR="$tmp/bins" \
      GPU_STATUS_ACTIVE=nvidia GPU_STATUS_NV_CONNECTED=1 \
      GPU_STATUS_NVIDIA_PRESENT=1 GPU_STATUS_INTEL_PRESENT=1 \
      GPU_STATUS_INTEL_NAME=UHD GPU_STATUS_NVIDIA_CSV= \
      GPU_STATUS_OUTPUTS='[]' \
      bash "$script" status
  )
  assert_jq "$json" '.apps | map(select(.id == "chromium")) | .[0].preference == "nvidia" and .[0].attached == false'

  XDG_CONFIG_HOME="$tmp/config" XDG_DATA_HOME="$tmp/data" \
    GPU_STATUS_BIN_DIR="$tmp/bins" GPU_STATUS_DESKTOP_DIR="$tmp/desktops" \
    GPU_STATUS_ACTIVE=nvidia GPU_STATUS_NV_CONNECTED=1 \
    GPU_STATUS_NVIDIA_PRESENT=1 GPU_STATUS_INTEL_PRESENT=1 \
    GPU_STATUS_OUTPUTS='[]' \
    bash "$script" set-app chromium desktop >/dev/null
  [[ $(cat "$tmp/data/applications/chromium.desktop") == $'Exec=chromium %U\nName=Mine' ]] || fail "Desktop removed a foreign menu entry"
  [[ ! -e $wrapper ]] || fail "Desktop left the chromium wrapper"
  if [[ -f $tmp/config/uwsm/gpu-apps ]] && grep -q '^chromium ' "$tmp/config/uwsm/gpu-apps"; then
    fail "Desktop left the chromium preference"
  fi

  rm -f "$tmp/data/applications/chromium.desktop"
  XDG_CONFIG_HOME="$tmp/config" XDG_DATA_HOME="$tmp/data" \
    GPU_STATUS_BIN_DIR="$tmp/bins" GPU_STATUS_DESKTOP_DIR="$tmp/desktops" \
    GPU_STATUS_ACTIVE=nvidia GPU_STATUS_NV_CONNECTED=1 \
    GPU_STATUS_NVIDIA_PRESENT=1 GPU_STATUS_INTEL_PRESENT=1 \
    GPU_STATUS_OUTPUTS='[]' \
    bash "$script" set-app chromium intel >/dev/null
  [[ -f $desk && -x $wrapper ]] || fail "pin did not return after Desktop"
  XDG_CONFIG_HOME="$tmp/config" XDG_DATA_HOME="$tmp/data" \
    GPU_STATUS_BIN_DIR="$tmp/bins" GPU_STATUS_DESKTOP_DIR="$tmp/desktops" \
    GPU_STATUS_ACTIVE=nvidia GPU_STATUS_NV_CONNECTED=1 \
    GPU_STATUS_NVIDIA_PRESENT=1 GPU_STATUS_INTEL_PRESENT=1 \
    GPU_STATUS_OUTPUTS='[]' \
    bash "$script" set-app chromium desktop >/dev/null
  [[ ! -e $desk && ! -e $wrapper ]] || fail "Desktop left a menu entry we created"
  if [[ -f $tmp/config/uwsm/gpu-apps ]] && grep -q '^chromium ' "$tmp/config/uwsm/gpu-apps"; then
    fail "Desktop left a marked app preference"
  fi
  [[ -x $tmp/data/aponhcet.gpu/bin/voxtype ]] || fail "removing chromium removed voxtype"
  [[ $(cat "$tmp/config/uwsm/gpu-mode") == "$mode_before" ]] || fail "app edits changed the login GPU"

  if command -v node >/dev/null 2>&1; then
    node -e '
const fs = require("fs")
const vm = require("vm")
const sandbox = {}
vm.createContext(sandbox)
vm.runInContext(fs.readFileSync(process.argv[1], "utf8"), sandbox)
if (typeof sandbox.plain !== "function") process.exit(1)
const dirty = sandbox.plain("<img src=\"https://evil.invalid/t.png\">&")
if (/[<>&]/.test(dirty)) process.exit(1)
if (sandbox.plain("RTX 3080") !== "RTX 3080") process.exit(1)
if (sandbox.plain(null) !== "") process.exit(1)
if (sandbox.plain("x".repeat(200)).length !== 96) process.exit(1)
if (!sandbox.allowedAppPref("desktop") || !sandbox.allowedAppPref("intel") || !sandbox.allowedAppPref("amd") || sandbox.allowedAppPref("auto")) process.exit(1)
if (!sandbox.allowedMode("amd") || sandbox.allowedMode("radeon")) process.exit(1)
if (!sandbox.allowedAppId("chromium") || sandbox.allowedAppId("chromium;touch") || sandbox.allowedAppId("../etc")) process.exit(1)
' "$(dirname "$script")/Model.js" || fail "Model.plain kept markup"
  else
    fail "node is required to test Model.plain"
  fi

  echo "gpu-status self-test ok"
}

command=${1:-brief}
case $command in
  --self-test)
    self_test
    ;;
  brief)
    detail=0
    emit_status
    ;;
  status)
    detail=1
    emit_status
    ;;
  set)
    write_preference "${2:-}"
    detail=0
    emit_status
    ;;
  set-app)
    set_app "${2:-}" "${3:-}"
    detail=0
    emit_status
    ;;
  *)
    echo "usage: gpu-status [brief|status|set auto|intel|nvidia|amd|set-app ID desktop|intel|nvidia|amd|--self-test]" >&2
    exit 2
    ;;
esac
