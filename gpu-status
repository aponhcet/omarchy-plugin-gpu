#!/bin/bash

# Report the desktop GPU and, with "set", remember which one the next
# login should use. Hyprland reads AQ_DRM_DEVICES only as it starts, so a
# choice here does not move the running session.
#
# "brief" is safe to poll: it does not call nvidia-smi, which wakes the
# discrete GPU, and it does not inspect apps. "status" adds names, NVIDIA
# power, and the app list for the open panel. "set-app" remembers Desktop,
# Intel, NVIDIA, or AMD for the next start of one program. AMD has no
# power reading here: the open panel shows its PCI name only.
#
# Tests inject GPU_STATUS_* instead of reading this machine. They must set
# XDG_CONFIG_HOME, or "set" would write the real login preference.

set -euo pipefail

mode_file() {
  local config_home=${XDG_CONFIG_HOME:-$HOME/.config}
  printf '%s\n' "$config_home/uwsm/gpu-mode"
}

clean_name() {
  local text=$1
  text=${text//$'\n'/ }
  text=${text//$'\r'/ }
  text=${text//$'\t'/ }
  text=${text//</}
  text=${text//>/}
  text=${text//&/}
  text=$(printf '%s' "$text" | tr -cd '[:print:]' | sed 's/^ *//;s/ *$//' | cut -c1-96)
  printf '%s' "$text"
}

json_number() {
  if [[ ${1:-} =~ ^[0-9]+([.][0-9]+)?$ ]]; then
    printf '%s' "$1"
  else
    printf 'null'
  fi
}

# lspci reports "Navi 22 [Radeon RX 6700 XT]". The bracketed product name
# is the one a person recognizes. NVIDIA names come from nvidia-smi and
# stay whole.
product_name() {
  local name inner
  name=$(clean_name "$1")
  if [[ $name == *'['*']'* ]]; then
    inner=${name#*[}
    inner=${inner%]*}
    inner=$(clean_name "$inner")
    [[ -n $inner ]] && name=$inner
  fi
  printf '%s' "$name"
}

# Tests point these at a fake tree. The installed widget reads the real devices.
dri_root() {
  printf '%s' "${GPU_STATUS_DRI_ROOT:-/dev/dri}"
}

sys_drm() {
  printf '%s' "${GPU_STATUS_SYS_DRM:-/sys/class/drm}"
}

card_vendor() {
  local node=$1 sys resolved card vendor
  sys=$(sys_drm)
  resolved=$(readlink -f "$node" 2>/dev/null || true)
  [[ -n $resolved ]] || return 0
  card=$(basename "$resolved")
  [[ $card =~ ^card[0-9]+$ ]] || return 0
  [[ -r $sys/$card/device/vendor ]] || return 0
  vendor=$(tr 'A-F' 'a-f' <"$sys/$card/device/vendor" | tr -d '[:space:]' || true)
  printf '%s' "$vendor"
}

find_vendor_card() {
  local want=$1 sys card vendor dev
  sys=$(sys_drm)
  shopt -s nullglob
  for dev in "$sys"/card[0-9]*; do
    card=$(basename "$dev")
    [[ $card =~ ^card[0-9]+$ ]] || continue
    [[ -r $dev/device/vendor ]] || continue
    vendor=$(tr 'A-F' 'a-f' <"$dev/device/vendor" | tr -d '[:space:]' || true)
    if [[ $vendor == "$want" ]]; then
      shopt -u nullglob
      printf '%s' "$card"
      return 0
    fi
  done
  shopt -u nullglob
  return 1
}

read_preference() {
  local file raw
  file=$(mode_file)
  preference=auto
  [[ -f $file ]] || return 0
  raw=$(head -c 16 "$file" 2>/dev/null || true)
  case $raw in
    intel*) preference=intel ;;
    nvidia*) preference=nvidia ;;
    amd*) preference=amd ;;
    auto*) preference=auto ;;
  esac
}

write_preference() {
  local mode=$1 file dir tmp
  case $mode in
    auto|intel|nvidia|amd) ;;
    *)
      echo "gpu-status: mode must be auto, intel, nvidia, or amd" >&2
      return 2
      ;;
  esac
  file=$(mode_file)
  dir=$(dirname "$file")
  mkdir -p "$dir"
  tmp=$(mktemp "$dir/.gpu-mode.XXXXXX")
  if ! printf '%s\n' "$mode" >"$tmp"; then
    rm -f "$tmp"
    return 1
  fi
  mv -f "$tmp" "$file"
}

apps_file() {
  local config_home=${XDG_CONFIG_HOME:-$HOME/.config}
  printf '%s\n' "$config_home/uwsm/gpu-apps"
}

data_root() {
  printf '%s' "${XDG_DATA_HOME:-$HOME/.local/share}"
}

plugin_dir() {
  dirname "$(readlink -f "$0")"
}

plugin_launch() {
  printf '%s' "$(plugin_dir)/gpu-launch"
}

unsafe_path() {
  [[ -z ${1:-} || $1 == *" "* || $1 == *$'\n'* || $1 == *$'\t'* ]]
}

valid_app_id() {
  [[ ${1:-} =~ ^[a-z0-9][a-z0-9._+-]{0,40}$ ]]
}

comm_id() {
  local name=${1%.exe}
  name=$(printf '%s' "$name" | tr '[:upper:]' '[:lower:]')
  printf '%s' "$name"
}

# Tests set GPU_STATUS_BIN_DIR and must not fall through to this machine.
resolve_bin() {
  local id=$1 candidate dir
  if [[ -n ${GPU_STATUS_BIN_DIR+x} ]]; then
    candidate=${GPU_STATUS_BIN_DIR}/$id
    if [[ -x $candidate && ! -d $candidate ]] && ! unsafe_path "$candidate"; then
      printf '%s' "$candidate"
      return 0
    fi
    return 1
  fi
  for dir in /usr/local/bin /usr/bin; do
    candidate=$dir/$id
    [[ -x $candidate && ! -d $candidate ]] || continue
    printf '%s' "$candidate"
    return 0
  done
  return 1
}

desktop_source_dir() {
  if [[ -n ${GPU_STATUS_DESKTOP_DIR+x} ]]; then
    printf '%s' "$GPU_STATUS_DESKTOP_DIR"
  else
    printf '%s' /usr/share/applications
  fi
}

wrapper_path() {
  printf '%s' "$(data_root)/aponhcet.gpu/bin/$1"
}

desktop_dest() {
  printf '%s' "$(data_root)/applications/$1.desktop"
}

wrapper_is_ours() {
  local path=$1 id=$2
  [[ -f $path && ! -L $path ]] || return 1
  grep -q -F "# aponhcet.gpu wrapper $id" "$path"
}

rewrite_exec_line() {
  local line=$1 id=$2 wrapper=$3
  local key rest token args base
  line=${line%$'\r'}
  case $line in
    Exec=* | TryExec=*) ;;
    *)
      printf '%s\n' "$line"
      return 0
      ;;
  esac
  key=${line%%=*}
  rest=${line#*=}
  token=$rest
  args=""
  if [[ $rest == *" "* ]]; then
    token=${rest%% *}
    args=${rest#* }
  fi
  [[ -n $token ]] || {
    printf '%s\n' "$line"
    return 0
  }
  base=$(basename -- "$token")
  if [[ $base != "$id" ]]; then
    printf '%s\n' "$line"
    return 0
  fi
  if [[ -n $args ]]; then
    printf '%s=%s %s\n' "$key" "$wrapper" "$args"
  else
    printf '%s=%s\n' "$key" "$wrapper"
  fi
}

# 0 written, 2 no menu entry, 3 a desktop file we did not create.
write_desktop() {
  local id=$1 wrapper=$2
  local src dest dir tmp line
  src=$(desktop_source_dir)/$id.desktop
  [[ -f $src && ! -L $src ]] || return 2
  dest=$(desktop_dest "$id")
  if [[ -e $dest || -L $dest ]]; then
    if [[ -L $dest || ! -f $dest ]]; then
      return 3
    fi
    if ! grep -q '^X-AponhcetGpu=1$' "$dest"; then
      return 3
    fi
  fi
  dir=$(dirname "$dest")
  mkdir -p "$dir"
  tmp=$(mktemp "$dir/.desktop.XXXXXX")
  while IFS= read -r line || [[ -n $line ]]; do
    rewrite_exec_line "$line" "$id" "$wrapper"
  done <"$src" >"$tmp"
  if ! grep -q '^X-AponhcetGpu=1$' "$tmp"; then
    printf 'X-AponhcetGpu=1\n' >>"$tmp"
  fi
  chmod 644 "$tmp"
  mv -f "$tmp" "$dest"
}

write_wrapper() {
  local id=$1
  local root path dir tmp launcher
  root=$(data_root)
  launcher=$(plugin_launch)
  if unsafe_path "$root" || unsafe_path "$launcher" || [[ ! -x $launcher ]]; then
    echo "gpu-status: launcher path is not usable" >&2
    return 1
  fi
  path=$(wrapper_path "$id")
  if [[ -e $path ]] && ! wrapper_is_ours "$path" "$id"; then
    echo "gpu-status: $path already exists" >&2
    return 1
  fi
  dir=$(dirname "$path")
  mkdir -p "$dir"
  tmp=$(mktemp "$dir/.wrapper.XXXXXX")
  {
    printf '%s\n' '#!/bin/bash'
    printf '# aponhcet.gpu wrapper %s\n' "$id"
    printf 'exec %q %q "$@"\n' "$launcher" "$id"
  } >"$tmp"
  chmod 755 "$tmp"
  mv -f "$tmp" "$path"
  printf '%s' "$path"
}

each_pin_line() {
  local file line
  file=$(apps_file)
  [[ -f $file ]] || return 0
  while IFS= read -r line || [[ -n $line ]]; do
    [[ $line =~ ^([a-z0-9][a-z0-9._+-]{0,40})[[:space:]]+(intel|nvidia|amd)[[:space:]]+(/[^[:space:]]+)[[:space:]]+([^[:space:]]+)$ ]] || continue
    printf '%s\n' "$line"
  done <"$file"
}

save_pref_line() {
  local id=$1 mode=$2 binary=$3 desktop=$4
  local file dir tmp line
  file=$(apps_file)
  dir=$(dirname "$file")
  mkdir -p "$dir"
  tmp=$(mktemp "$dir/.gpu-apps.XXXXXX")
  while IFS= read -r line; do
    [[ $line == "$id "* ]] && continue
    printf '%s\n' "$line"
  done < <(each_pin_line) >"$tmp"
  printf '%s %s %s %s\n' "$id" "$mode" "$binary" "$desktop" >>"$tmp"
  mv -f "$tmp" "$file"
}

delete_pref_line() {
  local id=$1
  local file dir tmp line
  file=$(apps_file)
  [[ -f $file ]] || return 0
  dir=$(dirname "$file")
  tmp=$(mktemp "$dir/.gpu-apps.XXXXXX")
  while IFS= read -r line; do
    [[ $line == "$id "* ]] && continue
    printf '%s\n' "$line"
  done < <(each_pin_line) >"$tmp"
  if [[ -s $tmp ]]; then
    mv -f "$tmp" "$file"
  else
    rm -f "$tmp" "$file"
  fi
}

remove_app_pin() {
  local id=$1 dest wrapper
  dest=$(desktop_dest "$id")
  if [[ -f $dest && ! -L $dest ]] && grep -q '^X-AponhcetGpu=1$' "$dest"; then
    rm -f "$dest"
  fi
  wrapper=$(wrapper_path "$id")
  if wrapper_is_ours "$wrapper" "$id"; then
    rm -f "$wrapper"
  fi
  delete_pref_line "$id"
}

lookup_pin() {
  local want=$1 line
  pin_mode=desktop
  pin_binary=""
  pin_desktop="-"
  while IFS= read -r line; do
    [[ $line =~ ^([a-z0-9][a-z0-9._+-]{0,40})[[:space:]]+(intel|nvidia|amd)[[:space:]]+(/[^[:space:]]+)[[:space:]]+([^[:space:]]+)$ ]] || continue
    [[ ${BASH_REMATCH[1]} == "$want" ]] || continue
    pin_mode=${BASH_REMATCH[2]}
    pin_binary=${BASH_REMATCH[3]}
    pin_desktop=${BASH_REMATCH[4]}
    return 0
  done < <(each_pin_line)
}

set_app() {
  local id=$1 mode=$2 binary wrapper desktop_name wrote
  valid_app_id "$id" || {
    echo "gpu-status: bad app id" >&2
    return 2
  }
  case $mode in
    desktop | intel | nvidia | amd) ;;
    *)
      echo "gpu-status: app mode must be desktop, intel, nvidia, or amd" >&2
      return 2
      ;;
  esac
  if [[ $mode == desktop ]]; then
    remove_app_pin "$id"
    return 0
  fi
  binary=$(resolve_bin "$id" || true)
  if [[ -z $binary ]] || unsafe_path "$binary"; then
    echo "gpu-status: no program for $id" >&2
    return 1
  fi
  case $binary in
    "$(data_root)/aponhcet.gpu/bin/"*)
      echo "gpu-status: refusing to wrap the wrapper" >&2
      return 1
      ;;
  esac
  wrapper=$(write_wrapper "$id")
  desktop_name="-"
  wrote=0
  if write_desktop "$id" "$wrapper"; then
    wrote=1
    desktop_name=$id.desktop
  fi
  save_pref_line "$id" "$mode" "$binary" "$desktop_name"
  [[ $wrote == 1 ]] || true
}

proc_comm() {
  local text
  text=$(cat "/proc/$1/comm" 2>/dev/null) || return 1
  printf '%s' "${text//$'\n'/}"
}

skip_app_comm() {
  case $1 in
    Hyprland | Xwayland | quickshell | wireplumber | pipewire | pipewire-pulse | systemd | dbus-broker | dbus-daemon | nvidia-smi | gpu-status)
      return 0
      ;;
    xdg-desktop-por* | omarchy-launch*)
      return 0
      ;;
  esac
  return 1
}

app_label() {
  local name=$1 first rest
  name=${name%.exe}
  name=$(clean_name "$name")
  name=${name//%/}
  [[ -n $name ]] || return 0
  first=${name:0:1}
  rest=${name:1}
  case $first in
    [a-z]) first=${first^} ;;
  esac
  printf '%s' "$first$rest"
}

add_app() {
  local id=$1 name=$2 gpu=$3 vendors=${4:-} count existing vendors_json
  [[ -n $name ]] || return 0
  case $gpu in
    intel | nvidia | amd | both | none) ;;
    *) return 0 ;;
  esac
  vendors_json=$(jq -nc --arg v "$vendors" '$v | split(",") | map(select(. == "intel" or . == "nvidia" or . == "amd")) | unique')
  valid_app_id "$id" || id=""
  if [[ -n $id ]]; then
    existing=$(jq -r --arg id "$id" 'map(select(.id == $id)) | .[0].gpu // ""' <<<"$apps_json")
  else
    existing=$(jq -r --arg name "$name" 'map(select(.id == "" and .name == $name)) | .[0].gpu // ""' <<<"$apps_json")
  fi
  if [[ -n $existing ]]; then
    if [[ $existing != "$gpu" ]]; then
      if [[ $existing == none ]]; then
        :
      elif [[ $gpu == none ]]; then
        gpu=$existing
      else
        gpu=both
      fi
    fi
    if [[ -n $id ]]; then
      apps_json=$(jq -c --arg id "$id" --arg gpu "$gpu" --argjson vendors "$vendors_json" \
        'map(if .id == $id then .gpu = $gpu | .vendors = ((.vendors // []) + $vendors | unique) else . end)' <<<"$apps_json")
    else
      apps_json=$(jq -c --arg name "$name" --arg gpu "$gpu" --argjson vendors "$vendors_json" \
        'map(if .id == "" and .name == $name then .gpu = $gpu | .vendors = ((.vendors // []) + $vendors | unique) else . end)' <<<"$apps_json")
    fi
    return 0
  fi
  count=$(jq 'length' <<<"$apps_json")
  [[ $count -ge 8 ]] && return 0
  apps_json=$(jq -c --arg id "$id" --arg name "$name" --arg gpu "$gpu" --argjson vendors "$vendors_json" \
    '. + [{id:$id, name:$name, gpu:$gpu, vendors:$vendors}]' <<<"$apps_json")
}

merge_saved_apps() {
  local line id label
  while IFS= read -r line; do
    [[ $line =~ ^([a-z0-9][a-z0-9._+-]{0,40})[[:space:]]+(intel|nvidia|amd)[[:space:]]+ ]] || continue
    id=${BASH_REMATCH[1]}
    if jq -e --arg id "$id" 'any(.[]; .id == $id)' <<<"$apps_json" >/dev/null; then
      continue
    fi
    label=$(app_label "$id")
    [[ -n $label ]] || label=$id
    add_app "$id" "$label" none
  done < <(each_pin_line)
}

annotate_apps() {
  local row id name gpu launchable attached dest out stored vendors
  out='[]'
  while IFS= read -r row; do
    [[ -n $row ]] || continue
    id=$(jq -r '.id // ""' <<<"$row")
    name=$(jq -r '.name // ""' <<<"$row")
    gpu=$(jq -r '.gpu // ""' <<<"$row")
    vendors=$(jq -c 'if (.vendors | type) == "array" then [.vendors[] | select(. == "intel" or . == "nvidia" or . == "amd")] else [] end' <<<"$row")
    lookup_pin "$id"
    launchable=false
    stored=$pin_binary
    if [[ -n $stored && -x $stored && ! -d $stored ]] && ! unsafe_path "$stored"; then
      launchable=true
    elif resolve_bin "$id" >/dev/null 2>&1; then
      launchable=true
    fi
    attached=false
    dest=$(desktop_dest "$id")
    if [[ -f $dest && ! -L $dest ]] && grep -q '^X-AponhcetGpu=1$' "$dest"; then
      attached=true
    fi
    out=$(jq -c \
      --arg id "$id" \
      --arg name "$name" \
      --arg gpu "$gpu" \
      --arg preference "$pin_mode" \
      --argjson vendors "$vendors" \
      --argjson launchable "$launchable" \
      --argjson attached "$attached" \
      '. + [{id:$id, name:$name, gpu:$gpu, vendors:$vendors, preference:$preference, launchable:$launchable, attached:$attached}]' <<<"$out")
  done < <(jq -c '.[]' <<<"$apps_json")
  apps_json=$out
}

gpu_holdings() {
  local pid=$1 fd target canon
  shopt -s nullglob
  for fd in /proc/"$pid"/fd/*; do
    target=$(readlink "$fd" 2>/dev/null) || continue
    case $target in
      /dev/dri/renderD[0-9]* | /dev/dri/by-path/*-render | /dev/nvidia[0-9]* | /dev/nvidiactl | /dev/nvidia-modeset | /dev/nvidia-uvm)
        canon=$(readlink -f "$target" 2>/dev/null || printf '%s' "$target")
        printf '%s\n' "$canon"
        ;;
    esac
  done | sort -u
  shopt -u nullglob
}

load_apps() {
  local row name gpu label id vendors
  apps_json='[]'
  [[ ${detail:-0} == 1 ]] || return 0
  if [[ -n ${GPU_STATUS_APPS+x} ]]; then
    if jq -e 'type == "array"' <<<"$GPU_STATUS_APPS" >/dev/null 2>&1; then
      while IFS= read -r row; do
        [[ -n $row ]] || continue
        name=$(jq -r '.name // ""' <<<"$row")
        gpu=$(jq -r '.gpu // ""' <<<"$row")
        id=$(jq -r '.id // ""' <<<"$row")
        vendors=$(jq -r 'if (.vendors | type) == "array" then [.vendors[] | select(. == "intel" or . == "nvidia" or . == "amd")] | join(",") else "" end' <<<"$row")
        label=$(app_label "$name")
        if [[ -z $id || $id == null ]]; then
          id=$(comm_id "$label")
        fi
        add_app "$id" "$label" "$gpu" "$vendors"
      done < <(jq -c '.[]' <<<"$GPU_STATUS_APPS")
    fi
  # Hermetic tests set GPU_STATUS_ACTIVE and must not inspect this machine.
  elif [[ -z ${GPU_STATUS_ACTIVE+x} ]]; then

  local -A render_gpu=() client_comm=()
  local path base vendor pid target node gpu nv ig amd comm label label_comm parent cur i uid app_id
  local -a mine theirs
  local holding found inherited self_comm best
  uid=$(id -u)
  shopt -s nullglob
  for path in /sys/class/drm/renderD[0-9]*; do
    [[ -d $path ]] || continue
    base=$(basename "$path")
    vendor=$(tr 'A-F' 'a-f' <"$path/device/vendor" 2>/dev/null | tr -d '[:space:]' || true)
    case $vendor in
      0x10de) render_gpu[$base]=nvidia ;;
      0x8086) render_gpu[$base]=intel ;;
      0x1002) render_gpu[$base]=amd ;;
    esac
  done

  if command -v hyprctl >/dev/null 2>&1; then
    while IFS= read -r pid; do
      [[ $pid =~ ^[0-9]+$ ]] || continue
      comm=$(proc_comm "$pid") || continue
      [[ -n $comm ]] && client_comm[$pid]=$comm
    done < <(hyprctl clients -j 2>/dev/null | jq -r '.[].pid' 2>/dev/null || true)
  fi

  while IFS= read -r pid; do
    pid=${pid//[[:space:]]/}
    [[ $pid =~ ^[0-9]+$ ]] || continue
    self_comm=$(proc_comm "$pid") || continue
    skip_app_comm "$self_comm" && continue
    mapfile -t mine < <(gpu_holdings "$pid")
    [[ ${#mine[@]} -eq 0 ]] && continue
    parent=$(awk '/^PPid:/ {print $2}' "/proc/$pid/status" 2>/dev/null || true)
    inherited=1
    if [[ ${#mine[@]} -gt 0 ]]; then
      mapfile -t theirs < <(gpu_holdings "$parent")
      for holding in "${mine[@]}"; do
        found=0
        for node in "${theirs[@]}"; do
          [[ $holding == "$node" ]] && found=1 && break
        done
        [[ $found == 0 ]] && inherited=0 && break
      done
      # A child that only keeps a device its parent already opened is not
      # drawing. Clipboard watchers and file monitors inherit the shell's fd.
      [[ $inherited == 1 && ${#theirs[@]} -gt 0 ]] && continue
    fi
    nv=0
    ig=0
    amd=0
    for holding in "${mine[@]}"; do
      base=$(basename "$holding")
      case $base in
        renderD[0-9]*)
          gpu=${render_gpu[$base]:-}
          [[ $gpu == nvidia ]] && nv=1
          [[ $gpu == intel ]] && ig=1
          [[ $gpu == amd ]] && amd=1
          ;;
        nvidia*)
          nv=1
          ;;
      esac
    done
    [[ $nv == 0 && $ig == 0 && $amd == 0 ]] && continue

    cur=$pid
    label=""
    label_comm=""
    for ((i = 0; i < 8; i++)); do
      if [[ -n ${client_comm[$cur]:-} ]]; then
        comm=${client_comm[$cur]}
        if ! skip_app_comm "$comm"; then
          label=$(app_label "$comm")
          label_comm=$comm
        fi
        break
      fi
      parent=$(awk '/^PPid:/ {print $2}' "/proc/$cur/status" 2>/dev/null || true)
      [[ $parent =~ ^[0-9]+$ ]] || break
      [[ $parent == 0 || $parent == 1 || $parent == "$cur" ]] && break
      cur=$parent
    done
    if [[ -z $label ]]; then
      cur=$pid
      best=""
      for ((i = 0; i < 8; i++)); do
        comm=$(proc_comm "$cur" || true)
        case $comm in
          qs | python | python3 | bash | sh | dash | node | "") ;;
          *)
            if ! skip_app_comm "$comm"; then
              best=$comm
            fi
            ;;
        esac
        parent=$(awk '/^PPid:/ {print $2}' "/proc/$cur/status" 2>/dev/null || true)
        [[ $parent =~ ^[0-9]+$ ]] || break
        [[ $parent == 0 || $parent == 1 || $parent == "$cur" ]] && break
        comm=$(proc_comm "$parent" || true)
        [[ $comm == systemd ]] && break
        cur=$parent
      done
      [[ -n $best ]] || best=$self_comm
      skip_app_comm "$best" && continue
      label=$(app_label "$best")
      label_comm=$best
    fi
    [[ -n $label ]] || continue
    app_id=$(comm_id "$label_comm")
    vendors=""
    [[ $ig == 1 ]] && vendors=intel
    [[ $nv == 1 ]] && vendors=${vendors:+$vendors,}nvidia
    [[ $amd == 1 ]] && vendors=${vendors:+$vendors,}amd
    if [[ $nv == 1 && $ig == 1 ]] || [[ $nv == 1 && $amd == 1 ]] || [[ $ig == 1 && $amd == 1 ]]; then
      add_app "$app_id" "$label" both "$vendors"
    elif [[ $nv == 1 ]]; then
      add_app "$app_id" "$label" nvidia "$vendors"
    elif [[ $amd == 1 ]]; then
      add_app "$app_id" "$label" amd "$vendors"
    else
      add_app "$app_id" "$label" intel "$vendors"
    fi
  done < <(ps -u "$uid" -o pid=)
  shopt -u nullglob
  fi
  merge_saved_apps
  apps_json=$(jq -c 'sort_by([if .gpu == "intel" then 1 else 0 end, .name])' <<<"$apps_json")
  annotate_apps
}

add_output() {
  local conn=$1 gpu=$2 desktop=$3 count
  [[ $conn =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]] || return 0
  case $gpu in
    intel|nvidia|amd|other) ;;
    *) return 0 ;;
  esac
  case $desktop in
    0|1) ;;
    *) desktop=0 ;;
  esac
  count=$(jq 'length' <<<"$outputs_json")
  [[ $count -ge 8 ]] && return 0
  outputs_json=$(jq -c \
    --arg connector "$conn" \
    --arg gpu "$gpu" \
    --argjson desktop "$([[ $desktop == 1 ]] && echo true || echo false)" \
    '. + [{connector:$connector, gpu:$gpu, desktop:$desktop}]' <<<"$outputs_json")
}

load_outputs() {
  local row conn gpu desktop
  outputs_json='[]'
  nvidia_connected=0
  amd_connected=0
  if [[ -n ${GPU_STATUS_OUTPUTS+x} ]]; then
    if jq -e 'type == "array"' <<<"$GPU_STATUS_OUTPUTS" >/dev/null 2>&1; then
      while IFS= read -r row; do
        [[ -n $row ]] || continue
        conn=$(jq -r '.connector // ""' <<<"$row")
        gpu=$(jq -r '.gpu // ""' <<<"$row")
        desktop=$(jq -r 'if .desktop == true then 1 else 0 end' <<<"$row")
        [[ $gpu == nvidia ]] && nvidia_connected=1
        [[ $gpu == amd ]] && amd_connected=1
        add_output "$conn" "$gpu" "$desktop"
      done < <(jq -c '.[]' <<<"$GPU_STATUS_OUTPUTS")
    fi
    return 0
  fi

  local nv_real="" ig_real="" desktop_names=() name card conn_name real vendor state dir desk dri sys boot
  dri=$(dri_root)
  sys=$(sys_drm)
  [[ -e $dri/nvidia-dgpu ]] && nv_real=$(readlink -f "$dri/nvidia-dgpu")
  [[ -e $dri/intel-igpu ]] && ig_real=$(readlink -f "$dri/intel-igpu")

  if [[ -n ${GPU_STATUS_DESKTOP+x} ]]; then
    IFS=',' read -r -a desktop_names <<<"$GPU_STATUS_DESKTOP"
  elif command -v hyprctl >/dev/null 2>&1; then
    while IFS= read -r name; do
      [[ -n $name ]] && desktop_names+=("$name")
    done < <(hyprctl monitors -j 2>/dev/null | jq -r '.[].name' 2>/dev/null || true)
  fi

  shopt -s nullglob
  for state_path in "$sys"/card*-*/status; do
    state=$(cat "$state_path" 2>/dev/null || true)
    [[ $state == connected ]] || continue
    dir=$(basename "$(dirname "$state_path")")
    card=${dir%%-*}
    conn_name=${dir#*-}
    [[ $conn_name == *riteback* ]] && continue
    gpu=other
    real=$(readlink -f "$dri/$card" 2>/dev/null || true)
    if [[ -n $nv_real && $real == "$nv_real" ]]; then
      gpu=nvidia
      nvidia_connected=1
    elif [[ -n $ig_real && $real == "$ig_real" ]]; then
      gpu=intel
    else
      vendor=$(cat "$sys/$card/device/vendor" 2>/dev/null || true)
      vendor=$(printf '%s' "$vendor" | tr 'A-F' 'a-f' | tr -d '[:space:]')
      case $vendor in
        0x10de)
          gpu=nvidia
          nvidia_connected=1
          ;;
        0x8086) gpu=intel ;;
        0x1002)
          gpu=amd
          # The internal panel of an AMD integrated GPU is the laptop on
          # its own, not a screen plugged into a discrete GPU. A missing
          # boot_vga file means discrete.
          boot=$(tr -d '[:space:]' <"$sys/$card/device/boot_vga" 2>/dev/null || true)
          [[ $boot == 1 ]] || amd_connected=1
          ;;
      esac
    fi
    desk=0
    for name in "${desktop_names[@]}"; do
      [[ $name == "$conn_name" ]] && desk=1
    done
    add_output "$conn_name" "$gpu" "$desk"
  done
  shopt -u nullglob
}

read_active() {
  local pid aq first resolved nv_real="" ig_real="" vendor dri
  active=unknown
  dri=$(dri_root)
  if [[ -n ${GPU_STATUS_ACTIVE:-} ]]; then
    active=$GPU_STATUS_ACTIVE
  else
    aq=""
    if [[ -n ${GPU_STATUS_AQ_DRM_DEVICES+x} ]]; then
      aq=$GPU_STATUS_AQ_DRM_DEVICES
    else
      pid=$(pgrep -u "$(id -u)" -x Hyprland || true)
      pid=${pid%%$'\n'*}
      if [[ -n $pid && -r /proc/$pid/environ ]]; then
        aq=$(tr '\0' '\n' <"/proc/$pid/environ" | sed -n 's/^AQ_DRM_DEVICES=//p' || true)
      fi
    fi
    first=${aq%%:*}
    [[ -e $dri/nvidia-dgpu ]] && nv_real=$(readlink -f "$dri/nvidia-dgpu")
    [[ -e $dri/intel-igpu ]] && ig_real=$(readlink -f "$dri/intel-igpu")
    if [[ -n $first ]]; then
      resolved=$(readlink -f "$first" 2>/dev/null || printf '%s' "$first")
      if [[ -n $nv_real && $resolved == "$nv_real" ]]; then
        active=nvidia
      elif [[ -n $ig_real && $resolved == "$ig_real" ]]; then
        active=intel
      else
        # Other laptops have no nvidia-dgpu or intel-igpu symlink. The PCI
        # vendor on the card node is enough, and reading it does not wake
        # the discrete GPU.
        vendor=$(card_vendor "$resolved")
        case $vendor in
          0x10de) active=nvidia ;;
          0x8086) active=intel ;;
          0x1002) active=amd ;;
          *)
            if [[ $first == *nvidia* ]]; then
              active=nvidia
            elif [[ $first == *intel* ]]; then
              active=intel
            elif [[ $first == *amd* ]]; then
              active=amd
            fi
            ;;
        esac
      fi
    fi
  fi
  case $active in
    intel|nvidia|amd|unknown) ;;
    *) active=unknown ;;
  esac
}

read_present() {
  local dri
  dri=$(dri_root)
  if [[ -n ${GPU_STATUS_NVIDIA_PRESENT+x} ]]; then
    nvidia_present=$GPU_STATUS_NVIDIA_PRESENT
  elif [[ -e $dri/nvidia-dgpu ]] || find_vendor_card 0x10de >/dev/null; then
    nvidia_present=1
  else
    nvidia_present=0
  fi
  if [[ -n ${GPU_STATUS_INTEL_PRESENT+x} ]]; then
    intel_present=$GPU_STATUS_INTEL_PRESENT
  elif [[ -e $dri/intel-igpu ]] || find_vendor_card 0x8086 >/dev/null; then
    intel_present=1
  else
    intel_present=0
  fi
  case $nvidia_present in
    0|1) ;;
    *) nvidia_present=0 ;;
  esac
  case $intel_present in
    0|1) ;;
    *) intel_present=0 ;;
  esac
  # Tests that pin Intel or NVIDIA and do not point at a fake sysfs tree
  # are not asking about this machine. Leave AMD absent instead of reading
  # the host.
  if [[ -n ${GPU_STATUS_AMD_PRESENT+x} ]]; then
    amd_present=$GPU_STATUS_AMD_PRESENT
  elif [[ -z ${GPU_STATUS_SYS_DRM+x} && ( -n ${GPU_STATUS_NVIDIA_PRESENT+x} || -n ${GPU_STATUS_INTEL_PRESENT+x} ) ]]; then
    amd_present=0
  elif find_vendor_card 0x1002 >/dev/null; then
    amd_present=1
  else
    amd_present=0
  fi
  case $amd_present in
    0|1) ;;
    *) amd_present=0 ;;
  esac
}

read_names() {
  local card slot line parsed
  intel_name=""
  nvidia_name=""
  amd_name=""
  nvidia_util=""
  nvidia_power=""
  nvidia_mem=""
  [[ ${detail:-0} == 1 ]] || return 0

  if [[ -n ${GPU_STATUS_INTEL_NAME+x} ]]; then
    intel_name=$GPU_STATUS_INTEL_NAME
  else
    card=""
    if [[ -e $(dri_root)/intel-igpu ]]; then
      card=$(basename "$(readlink -f "$(dri_root)/intel-igpu")")
    else
      card=$(find_vendor_card 0x8086 || true)
    fi
    if [[ -n $card ]] && command -v lspci >/dev/null 2>&1; then
      slot=$(basename "$(readlink -f "$(sys_drm)/$card/device")" 2>/dev/null || true)
      if [[ -n $slot ]]; then
        intel_name=$(lspci -mm -s "$slot" 2>/dev/null | awk -F'"' '{print $6}' || true)
      fi
    fi
  fi

  if [[ -n ${GPU_STATUS_NVIDIA_CSV+x} ]]; then
    line=$GPU_STATUS_NVIDIA_CSV
  elif [[ $nvidia_present == 1 ]] && command -v nvidia-smi >/dev/null 2>&1; then
    line=$(timeout 2 nvidia-smi --query-gpu=name,utilization.gpu,power.draw,memory.used --format=csv,noheader,nounits 2>/dev/null | head -n 1 || true)
  else
    line=""
  fi
  if [[ -n $line ]]; then
    parsed=$(printf '%s\n' "$line" | awk -F',' '
      NF < 4 { exit 1 }
      {
        name = $1
        for (i = 2; i <= NF - 3; i++) name = name "," $i
        gsub(/^[ \t]+|[ \t]+$/, "", name)
        gsub(/^[ \t]+|[ \t]+$/, "", $(NF - 2))
        gsub(/^[ \t]+|[ \t]+$/, "", $(NF - 1))
        gsub(/^[ \t]+|[ \t]+$/, "", $NF)
        print name
        print $(NF - 2)
        print $(NF - 1)
        print $NF
      }') || parsed=""
    if [[ -n $parsed ]]; then
      nvidia_name=$(printf '%s\n' "$parsed" | sed -n '1p')
      nvidia_util=$(printf '%s\n' "$parsed" | sed -n '2p')
      nvidia_power=$(printf '%s\n' "$parsed" | sed -n '3p')
      nvidia_mem=$(printf '%s\n' "$parsed" | sed -n '4p')
    fi
  fi

  if [[ -n ${GPU_STATUS_AMD_NAME+x} ]]; then
    amd_name=$GPU_STATUS_AMD_NAME
  elif [[ -z ${GPU_STATUS_SYS_DRM+x} && ( -n ${GPU_STATUS_NVIDIA_PRESENT+x} || -n ${GPU_STATUS_INTEL_PRESENT+x} ) ]]; then
    amd_name=""
  else
    card=""
    card=$(find_vendor_card 0x1002 || true)
    if [[ -n $card ]] && command -v lspci >/dev/null 2>&1; then
      slot=$(basename "$(readlink -f "$(sys_drm)/$card/device")" 2>/dev/null || true)
      if [[ -n $slot ]]; then
        amd_name=$(lspci -mm -s "$slot" 2>/dev/null | awk -F'"' '{print $6}' || true)
      fi
    fi
  fi

  intel_name=$(product_name "$intel_name")
  amd_name=$(product_name "$amd_name")
  nvidia_name=$(clean_name "$nvidia_name")
}

emit_status() {
  local next=intel needs_logout=0
  read_preference
  read_present
  read_active
  load_outputs
  if [[ -n ${GPU_STATUS_NV_CONNECTED+x} ]]; then
    case $GPU_STATUS_NV_CONNECTED in
      1) nvidia_connected=1 ;;
      *) nvidia_connected=0 ;;
    esac
  fi
  if [[ -n ${GPU_STATUS_AMD_CONNECTED+x} ]]; then
    case $GPU_STATUS_AMD_CONNECTED in
      1) amd_connected=1 ;;
      *) amd_connected=0 ;;
    esac
  fi
  read_names
  load_apps

  case $preference in
    intel) next=intel ;;
    nvidia) next=nvidia ;;
    amd) next=amd ;;
    *)
      # NVIDIA with a screen, then a discrete AMD GPU with a screen, then
      # Intel, then an AMD integrated GPU, then NVIDIA with nothing attached.
      if [[ $nvidia_connected == 1 ]]; then
        next=nvidia
      elif [[ $amd_connected == 1 ]]; then
        next=amd
      elif [[ $intel_present == 1 ]]; then
        next=intel
      elif [[ $amd_present == 1 ]]; then
        next=amd
      elif [[ $nvidia_present == 1 ]]; then
        next=nvidia
      else
        next=intel
      fi
      ;;
  esac

  if [[ $active == intel || $active == nvidia || $active == amd ]] && [[ $next != "$active" ]]; then
    if [[ $next == nvidia && $nvidia_present == 1 ]]; then
      needs_logout=1
    elif [[ $next == intel && $intel_present == 1 ]]; then
      needs_logout=1
    elif [[ $next == amd && $amd_present == 1 ]]; then
      needs_logout=1
    fi
  fi

  jq -n \
    --arg active "$active" \
    --arg preference "$preference" \
    --arg next "$next" \
    --arg intelName "$intel_name" \
    --arg nvidiaName "$nvidia_name" \
    --arg amdName "$amd_name" \
    --argjson detail "$([[ ${detail:-0} == 1 ]] && echo true || echo false)" \
    --argjson needsLogout "$([[ $needs_logout == 1 ]] && echo true || echo false)" \
    --argjson intelPresent "$([[ $intel_present == 1 ]] && echo true || echo false)" \
    --argjson nvidiaPresent "$([[ $nvidia_present == 1 ]] && echo true || echo false)" \
    --argjson amdPresent "$([[ $amd_present == 1 ]] && echo true || echo false)" \
    --argjson nvidiaConnected "$([[ $nvidia_connected == 1 ]] && echo true || echo false)" \
    --argjson amdConnected "$([[ $amd_connected == 1 ]] && echo true || echo false)" \
    --argjson nvidiaUtil "$(json_number "$nvidia_util")" \
    --argjson nvidiaPower "$(json_number "$nvidia_power")" \
    --argjson nvidiaMem "$(json_number "$nvidia_mem")" \
    --argjson outputs "$outputs_json" \
    --argjson apps "$apps_json" \
    '{active:$active, preference:$preference, next:$next, intelName:$intelName,
      nvidiaName:$nvidiaName, amdName:$amdName, detail:$detail, needsLogout:$needsLogout,
      intelPresent:$intelPresent, nvidiaPresent:$nvidiaPresent, amdPresent:$amdPresent,
      nvidiaConnected:$nvidiaConnected, amdConnected:$amdConnected, nvidiaUtil:$nvidiaUtil,
      nvidiaPower:$nvidiaPower, nvidiaMem:$nvidiaMem, outputs:$outputs, apps:$apps}'
}

self_test() {
  local tmp script json code
  tmp=$(mktemp -d)
  script=$(readlink -f "$0")
  trap 'rm -rf "$tmp"' RETURN
  mkdir -p "$tmp/config/uwsm" "$tmp/nobin" "$tmp/data"

  fail() {
    echo "gpu-status self-test failed: $*" >&2
    exit 1
  }

  assert_jq() {
    local body=$1 filter=$2
    if ! printf '%s' "$body" | jq -e "$filter" >/dev/null; then
      echo "gpu-status self-test failed: $filter" >&2
      printf '%s\n' "$body" >&2
      exit 1
    fi
  }

  json=$(
    XDG_CONFIG_HOME="$tmp/config" \
      GPU_STATUS_ACTIVE=intel \
      GPU_STATUS_NV_CONNECTED=1 \
      GPU_STATUS_NVIDIA_PRESENT=1 \
      GPU_STATUS_INTEL_PRESENT=1 \
      GPU_STATUS_INTEL_NAME='<b>UHD</b>' \
      GPU_STATUS_AMD_NAME='Navi 22 [RX 6700]' \
      GPU_STATUS_NVIDIA_CSV='<img src="https://evil.invalid/t.png">&, 12, 19.5, 100' \
      GPU_STATUS_OUTPUTS='[{"connector":"DP-3","gpu":"nvidia","desktop":true},{"connector":"<bad>","gpu":"intel"},{"connector":"HDMI-A-1","gpu":"amd"}]' \
      GPU_STATUS_APPS='[{"name":"<&Chromium>","gpu":"nvidia"},{"name":"foot","gpu":"intel"},{"name":"Game","gpu":"both","vendors":["nvidia","intel"]},{"name":"nope","gpu":"bogus"},{"name":"Radeon","gpu":"amd"},{"name":"","gpu":"intel"}]' \
      GPU_STATUS_BIN_DIR="$tmp/nobin" \
      XDG_DATA_HOME="$tmp/data" \
      bash "$script" status
  )
  assert_jq "$json" '.active == "intel" and .preference == "auto" and .next == "nvidia" and .needsLogout == true and .detail == true and .amdConnected == true'
  assert_jq "$json" '.nvidiaUtil == 12 and .nvidiaPower == 19.5 and .nvidiaMem == 100 and .amdName == "RX 6700"'
  assert_jq "$json" '.outputs | length == 2 and .[0].connector == "DP-3" and .[0].desktop == true and .[1].connector == "HDMI-A-1" and .[1].gpu == "amd"'
  assert_jq "$json" '.apps | length == 4 and .[0].id == "chromium" and .[0].name == "Chromium" and .[0].gpu == "nvidia" and .[0].preference == "desktop" and .[0].launchable == false and .[1].id == "game" and .[1].name == "Game" and .[1].gpu == "both" and .[1].vendors == ["intel","nvidia"] and .[2].id == "radeon" and .[2].gpu == "amd" and .[3].id == "foot" and .[3].name == "Foot" and .[3].gpu == "intel"'
  if printf '%s' "$json" | jq -r '.intelName, .nvidiaName, .amdName, .outputs[].connector, .apps[].name, .apps[].id' | grep -q '[<>&]'; then
    fail "markup survived in a name shown by the panel"
  fi

  printf '%s\n' intel >"$tmp/config/uwsm/gpu-mode"
  json=$(
    XDG_CONFIG_HOME="$tmp/config" \
      GPU_STATUS_ACTIVE=nvidia \
      GPU_STATUS_NV_CONNECTED=1 \
      GPU_STATUS_NVIDIA_PRESENT=1 \
      GPU_STATUS_INTEL_PRESENT=1 \
      GPU_STATUS_OUTPUTS='[]' \
      bash "$script" brief
  )
  assert_jq "$json" '.preference == "intel" and .next == "intel" and .needsLogout == true and .detail == false and .nvidiaUtil == null and .apps == []'

  rm -f "$tmp/config/uwsm/gpu-mode"
  json=$(
    XDG_CONFIG_HOME="$tmp/config" \
      GPU_STATUS_ACTIVE=intel \
      GPU_STATUS_NV_CONNECTED=0 \
      GPU_STATUS_NVIDIA_PRESENT=1 \
      GPU_STATUS_INTEL_PRESENT=1 \
      GPU_STATUS_OUTPUTS='[]' \
      bash "$script" brief
  )
  assert_jq "$json" '.next == "intel" and .needsLogout == false'

  json=$(
    XDG_CONFIG_HOME="$tmp/config" \
      GPU_STATUS_ACTIVE=intel \
      GPU_STATUS_NV_CONNECTED=1 \
      GPU_STATUS_NVIDIA_PRESENT=0 \
      GPU_STATUS_INTEL_PRESENT=1 \
      GPU_STATUS_OUTPUTS='[]' \
      bash "$script" brief
